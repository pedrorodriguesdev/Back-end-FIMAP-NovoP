# PARA QUE SERVE: mostrar os campos de configuração da IA e da porta do backend.
# QUANDO ENTRA EM AÇÃO: quando você copia os campos necessários para o seu .env local.
# QUANDO FAZ DIFERENÇA: permite escolher o endereço da IA sem editar o serviço.
# Este arquivo é um exemplo; o backend carrega o .env, não o .env.example.

# URL pública padrão da IA. O prompt e o modelo ficam no Worker.
CLOUDFLARE_WORKER_URL=https://back-end-fimap.pedroday813.workers.dev/v1/ia/chat-publico
# Para usar um Worker protegido em /chat, configure o mesmo token nos dois serviços.
CLOUDFLARE_CHAT_TOKEN=
PORT=8080
